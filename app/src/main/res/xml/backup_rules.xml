<?xml version="1.0" encoding="utf-8"?>
<!--
  只备份"配置项"，绝不备份任何运行期数据。
  聊天文本本来就不落盘（内存中仅保留当前会话最近 N 条），此处进一步排除 shared_pref 之外的目录。
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="kf_runtime_cache.xml" />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
